generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  CONSULTATIONS
  EXAMS
  MEDICAL_RECORDS
  TELEMEDICINE
}

enum ProfessionalType {
  DOCTORS
  NURSES
  TECHNICIANS
  DIARIES
  PRESCRIPTIONS
}

model Patient {
  id             String        @id @default(uuid())
  name           String
  cpf            String        @unique
  password       String
  hospitalUnitId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  hospitalUnit   HospitalUnity @relation(fields: [hospitalUnitId], references: [id])
}

model HospitalUnity {
  id                  String               @id @default(uuid())
  name                String
  address             String
  beds                Int
  financialReport     Int
  supplies            Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  patients            Patient[]
  healthProfessionals HealthProfessional[]
  services            Service[]
}

model HealthProfessional {
  id                String       @id @default(uuid())
  name              String
  cpf               String       @unique
  password          String
  isAdmin           Boolean      @default(false)
  hospitalUnitId    String
  serviceType       ServiceType
  professionalType  ProfessionalType
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  services          Service[]    @relation("HealthProfessionalServices")
  hospitalUnit      HospitalUnity     @relation(fields: [hospitalUnitId], references: [id])
}

model Service {
  id                   String             @id @default(uuid())
  description          String
  serviceDate          DateTime
  isServiceCompleted   Boolean            @default(false)
  hospitalUnitId       String
  healthProfessionalId String
  serviceType          ServiceType
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  hospitalUnit         HospitalUnity      @relation(fields: [hospitalUnitId], references: [id])
  healthProfessional   HealthProfessional @relation("HealthProfessionalServices", fields: [healthProfessionalId], references: [id])
}